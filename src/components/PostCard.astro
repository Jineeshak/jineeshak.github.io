---
import Icon from './Icon.astro';
interface Props {
  post: {
    id: string;
    data: {
      title: string;
      description: string;
      date: Date;
      categories: string[];
      tags: string[];
    };
  };
}
const { post } = Astro.props;
const href = `/posts/${post.data.slug ?? post.id}/`;
const dateStr = post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<article class="card">
  <div class="meta mono">
    <span><Icon name="calendar" size={14} /> {dateStr}</span>
    {post.data.categories[0] && <span><Icon name="folder" size={14} /> {post.data.categories[0]}</span>}
  </div>
  <h3><a href={href}>{post.data.title}</a></h3>
  <p>{post.data.description}</p>
  {post.data.tags.length > 0 && (
    <div class="tags">
      {post.data.tags.slice(0, 4).map((t) => (
        <a class="pill" href={`/tags/${t}/`}>#{t}</a>
      ))}
    </div>
  )}
</article>

<style>
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.3rem 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    transition: border-color 0.15s, transform 0.15s;
  }
  .card:hover { border-color: var(--border-strong); transform: translateY(-2px); }
  .meta { display: flex; gap: 1rem; font-size: 0.76rem; color: var(--muted); flex-wrap: wrap; }
  .meta span { display: inline-flex; align-items: center; gap: 0.35em; }
  h3 { margin: 0; font-size: 1.15rem; }
  h3 a { color: var(--text-strong); }
  h3 a:hover { color: var(--accent); }
  p { margin: 0; color: var(--muted); font-size: 0.92rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .tags { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.2rem; }
</style>
