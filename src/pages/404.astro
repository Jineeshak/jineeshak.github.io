---
import Base from '../layouts/Base.astro';
---
<Base title="404 Not Found">
  <div class="not-found">
    <p class="eyebrow">error</p>
    <h1>404</h1>
    <p>This page doesn't exist. Maybe it got pwned.</p>
    <a class="btn btn--primary" href="/">&larr; Back home</a>
  </div>
</Base>

<style>
  .not-found { text-align: center; padding-block: 4rem; }
  .not-found h1 { font-size: 5rem; margin-bottom: 0; }
  .not-found p { color: var(--muted); margin-bottom: 1.5rem; }
</style>
